# Número comercial de WhatsApp en formato internacional, sólo dígitos (sin +, espacios ni guiones).
# Configúralo en Vercel → Project → Settings → Environment Variables. Nunca lo subas en un .env real.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública canónica del sitio (sin barra final).
NEXT_PUBLIC_SITE_URL=https://guglielmini.vercel.app
